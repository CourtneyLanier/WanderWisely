VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Dev-only: treat this browser as premium without a profiles row
# (also settable per-browser via localStorage key "ww-premium-override" = "true")
VITE_PREMIUM_OVERRIDE=false

# Weather (Open-Meteo). Defaults to the free non-commercial endpoints when
# unset. For the commercial tier, point these at the customer- endpoints and
# set the API key — no code change needed.
# VITE_OPEN_METEO_FORECAST_URL=https://customer-api.open-meteo.com/v1/forecast
# VITE_OPEN_METEO_ARCHIVE_URL=https://customer-archive-api.open-meteo.com/v1/archive
# VITE_OPEN_METEO_API_KEY=your_open_meteo_api_key

# Anthropic API key is NOT a frontend env var — it lives as a Supabase
# Edge Function secret named ANTHROPIC_API_KEY and is only used by
# supabase/functions/parse-with-claude.
